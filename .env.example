# ==============================================================
# ASSISTPAY — ENVIRONMENT VARIABLES (RENDER & PRODUCTION)
# ==============================================================
# Copy these values into your Render Dashboard under:
# Web Service -> Environment -> Add Environment Variable

# --------------------------------------------------------------
# 1. DATABASE CONFIGURATION (REQUIRED)
# --------------------------------------------------------------
# Recommended Free Cloud MySQL: TiDB Cloud Serverless (tidbcloud.com)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=assistpay
DB_USER=your_tidb_username.root
DB_PASS=your_tidb_password

# --------------------------------------------------------------
# 2. APPLICATION RUNTIME (RENDER AUTO-SETS PORT)
# --------------------------------------------------------------
# Render automatically injects PORT (e.g. 10000). The Dockerfile binds to it automatically.
# PORT=10000

# --------------------------------------------------------------
# 3. GOOGLE GEMINI AI (OPTIONAL FOR COORDINATOR AI CHATBOT)
# --------------------------------------------------------------
# If left empty, AssistPay automatically uses free fallback AI (Llama 3.3).
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --------------------------------------------------------------
# 4. EMAIL / SMTP NOTIFICATIONS (OPTIONAL FOR PASSWORD RESET)
# --------------------------------------------------------------
# For Gmail, generate an App Password in your Google Account security settings.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=AssistPay NCST

# --------------------------------------------------------------
# 5. SMS NOTIFICATIONS (OPTIONAL)
# --------------------------------------------------------------
# Provider options: ANDROID_GATEWAY | SEMAPHORE | TEXTBEE
SMS_PROVIDER=ANDROID_GATEWAY
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
